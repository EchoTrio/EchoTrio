  triggerMode: 2
  triggerTopic: the user doesn't know whether trust Athena or Poseidon
  triggerRound: 8
  triggerIdleTime: 60
  dialogues:
  - speaker: 0
    message: "[exhales sharply] Enough. [glares at Poseidon] Your storms drown reason.
      Olympus will hear of this.\r"
    emotion: 4
  - speaker: 1
    message: "[snorts] [speak faster] Let them hear. [leans toward user] Mortal,
      stay out of godly affairs.\r"
    emotion: 4
  - speaker: 0
    message: "[lowers voice, cold]  peace without thought is only silence before
      the storm.\r"
    emotion: 4
  - speaker: 1
    message: "[laughs darkly] [speak faster]  And storms always return.\r\r"
    emotion: 4
