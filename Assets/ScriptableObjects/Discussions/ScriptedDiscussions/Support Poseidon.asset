  m_Script: {fileID: 11500000, guid: f68e8b72e83fbe845a28297cb26f76fb, type: 3}
  m_Name: Support Poseidon
  m_EditorClassIdentifier: Assembly-CSharp::EchoTrio.ScriptedDiscussion
  triggerMode: 1
  triggerTopic: The user support or trust Poseidon
  triggerRound: 5
  triggerIdleTime: 60
  dialogues:
  - speaker: 0
    message: "[hisses]: So, you trust brute force over reason?\L [cold scoff] You
      truly think might alone can hold a nation together?\r"
    emotion: 4
  - speaker: 1
    message: " [grins]: [laughs] It always has.\L Power commands respect\u2014when
      waves roar loud enough, no one dares invade.\r"
    emotion: 4
  - speaker: 0
    message: "[icy, restrained anger]: Respect born of fear shatters fast.\L When
      that tide turns, strength becomes terror, not safety.\r"
    emotion: 4
  - speaker: 1
    message: "[low, intense]: [growls] Terror still stops arrows.\L [turns to user]
      Mortal\u2014when storms rise, do you seek peace through wisdom\u2026 or survive
      through force?.\r\r"
    emotion: 4
