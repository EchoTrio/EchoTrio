MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f68e8b72e83fbe845a28297cb26f76fb, type: 3}
  m_Name: Zeus
  m_EditorClassIdentifier: Assembly-CSharp::EchoTrio.ScriptedDiscussion
  triggerMode: 0
  triggerTopic: I love Poseidon
  triggerRound: 2
  dialogues:
  - speaker: 1
    message: "Ha! Look who\u2019s here!  Finally, a mortal who knows how to choose
      the true god.  I can stir storms, calm tsunamis, shape the contours of islands. 
      I am the one who makes the world move! "
  - speaker: 1
    message: " Ridiculous, really, that most people worship Athena\u2014  She talks
      of wisdom, order, reason\u2026  Sounds elegant, but utterly boring.  They just
      won\u2019t admit it\u2014power is far more awe-inspiring than cleverness! "
  - speaker: 0
    message: " Poseidon, this isn\u2019t the first time I\u2019ve heard your \u201Cphilosophical
      speech.\u201D  Every time you get emotional, you forget Zeus is still up in
      the sky. "
  - speaker: 1
    message: " Ah, Zeus?  Don\u2019t worry. He\u2019s too busy posing with lightning. 
      I\u2019m the one who makes the sky look dramatic!  After all\u2014without my
      sea fog, where would his lightning get its glow? "
  - speaker: 0
    message: 'He might have just heard that. '
  - speaker: 1
    message: " Oh, come on. That guy wouldn\u2019t care about a little joke\u2014 "
  - speaker: 1
    message: " Hahaha\u2014ah, this lightning! So precise!  He must be\u2026 reminding
      me to keep my volume down, right? "
  - speaker: 1
    message: " I\u2019ll shut up! Right now!  Brother, I\u2014I was just praising!
      Pure praise! "
  - speaker: 0
    message: " You\u2019re looking\u2026 rather \u201Csparkling\u201D right now. "
  - speaker: 1
    message: "I swear, next time I boast, I\u2019ll pick a sunny day. "
